PORT=3000
SESSION_SECRET=change-me
WIKIMEDIA_CONTACT=you@example.com
WIKIDATA_SPARQL_ENDPOINT=https://query.wikidata.org/sparql
WIKIDATA_API=https://www.wikidata.org/w/api.php
WIKIPEDIA_API=https://en.wikipedia.org/w/api.php
CACHE_TTL_MS=900000
# Change tags for edits to Wikidata, comma-separated. Leave empty until the tag exists on Wikidata.
WIKIDATA_EDIT_TAGS=

# OAuth 2.0 (Wikimedia)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback
OAUTH_AUTH_BASE=https://meta.wikimedia.org
OAUTH_AUTHORIZE_URL=https://meta.wikimedia.org/w/rest.php/oauth2/authorize
OAUTH_TOKEN_URL=https://meta.wikimedia.org/w/rest.php/oauth2/access_token
OAUTH_PROFILE_URL=https://www.wikidata.org/w/rest.php/oauth2/resource/profile
OAUTH_SCOPE=

# Local testing only: log in with an owner-only consumer's access token instead of the OAuth
# redirect flow. Every login becomes the token's owner, so it is refused when NODE_ENV=production.
# Never enable on Toolforge.
OAUTH_OWNER_ONLY=false
OAUTH_OWNER_ACCESS_TOKEN=

# Commit hash shown in the footer. Only needed where the server runs without a .git directory.
GIT_COMMIT=
